# Giftishow Biz API — SERVER ONLY.
# Never expose these values with NEXT_PUBLIC_ prefixes or commit production keys.
# Giftishow v1.05 supports only the production environment (dev_yn=N), so successful
# sends deduct real Bizmoney.
GIFTISHOW_AUTH_CODE=replace-with-production-auth-code
GIFTISHOW_AUTH_TOKEN=replace-with-production-token

# Required account settings. USER_ID is the Giftishow Biz login email and
# CALLBACK_NO is the registered sending number without hyphens.
GIFTISHOW_USER_ID=
GIFTISHOW_CALLBACK_NO=

# Optional MMS template/banner IDs configured in Giftishow Biz.
GIFTISHOW_TEMPLATE_ID=
GIFTISHOW_BANNER_ID=

# Optional default product shown in /admin/gifts.
GIFTISHOW_DEFAULT_GOODS_CODE=G00003320983
