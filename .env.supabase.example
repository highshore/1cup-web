# Supabase frontend env — copy to .env.local (gitignored) and fill.
# anon key is public-safe; service_role is SERVER-ONLY (no NEXT_PUBLIC_ prefix).
NEXT_PUBLIC_SUPABASE_URL=https://hetiycbotgjeluteicyk.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...anon-public-key...
SUPABASE_SERVICE_ROLE_KEY=eyJ...service-role-key...   # server only (route handlers/admin)

# --- Phone OTP via Kakao AlimTalk (app/api/phone-otp/*) — all SERVER-only ---
OTP_HMAC_SECRET=change-me-long-random   # peppers the OTP hash + derives the per-user password
TOAST_APPKEY=LROcHEW7abBbFhzc           # NHN Toast AlimTalk appkey
TOAST_SECRET_KEY=...                     # Toast X-Secret-Key (rotate the old hardcoded one)
TOAST_SENDER_KEY=1763d8030dde5f5f369ea0a088598c2fb4c792ab  # AlimTalk sender key (카카오 채널)
ALIMTALK_OTP_TEMPLATE_CODE=signin_otp    # your APPROVED OTP template code
OTP_SMS_FALLBACK=true                     # auto-resend as SMS/LMS if AlimTalk fails (needs Toast SMS product)
# OTP_TEMPLATE_VAR=code                   # template variable name (default "code")
# OTP_BRAND=영어 한잔                       # brand prefix in the message text
