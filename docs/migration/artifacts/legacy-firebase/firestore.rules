rules_version = '2';

// ARCHIVED — Firestore is decommissioned; product data lives in Supabase.
//
// This file is a migration artifact. `firebase.json` declares no firestore target
// and no repository script deploys one, so nothing here is applied by this repo.
//
// The rules that were archived here are NOT reproduced, because they were unsafe to
// keep lying around in deployable form: the catch-all
// `match /{collection}/{document=**}` granted `read, write` to anyone — no auth
// check at all — for every collection that was not on a hand-maintained blocklist,
// `users` included. Anyone who ran `firebase deploy --only firestore` against this
// file would have reopened world read/write on the whole database.
//
// The original text is preserved in git history (last content commit 52abcf0) if it
// is ever needed as a migration reference. The equivalent access rules now live as
// Postgres RLS policies in supabase/migrations/.
//
// Deny everything, so an accidental deploy fails closed instead of open.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
