# Growth agent configuration — copy to .env for local runs.
# In production, set these as Cloud Run env vars / Secret Manager secrets.
# NEVER commit real secrets.

# Anthropic (the strategist)
ANTHROPIC_API_KEY=sk-ant-...
GROWTH_MODEL=claude-opus-4-8

# Firebase Admin (service account). Either point at a key file…
# GOOGLE_APPLICATION_CREDENTIALS=/secrets/service-account.json
# …or provide the three fields inline (same values as the web app's .env.local):
FIREBASE_PROJECT_ID=one-cup-eng
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-...@one-cup-eng.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Koreapas channel credentials (ROTATE the password — it was exposed in chat)
KOREAPAS_USER_ID=highshore
KOREAPAS_PASSWORD=change-me

# Public site base used to build tracked links
SITE_BASE_URL=https://1cupenglish.com
