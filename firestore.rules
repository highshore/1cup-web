rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Blog posts rules
    match /blog_posts/{postId} {
      // Anyone can read published blog posts
      allow read: if resource.data.status == 'published' || 
                     (request.auth != null && 
                      get(/databases/$(database)/documents/users/$(request.auth.uid)).data.account_status == 'admin');
      
      // Only admins can write blog posts
      allow write: if request.auth != null && 
                      get(/databases/$(database)/documents/users/$(request.auth.uid)).data.account_status == 'admin';
    }
    
    // Member celebrations (leaderboard celebration wall)
    match /celebrations/{celebrationId} {
      // Anyone can read celebrations
      allow read: if true;

      // Only admins can create/update/delete celebrations
      allow write: if request.auth != null &&
                      get(/databases/$(database)/documents/users/$(request.auth.uid)).data.account_status == 'admin';
    }

    // Growth / marketing agent — admin-only from the client.
    // The agent itself runs on Cloud Run via the Admin SDK, which bypasses rules.
    match /growth_posts/{postId} {
      allow read, write: if request.auth != null &&
                            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.account_status == 'admin';
    }
    match /growth_iterations/{iterationId} {
      allow read, write: if request.auth != null &&
                            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.account_status == 'admin';
    }
    match /growth_config/{docId} {
      allow read, write: if request.auth != null &&
                            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.account_status == 'admin';
    }
    match /marketing_cron_runs/{runId} {
      allow read, write: if request.auth != null &&
                            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.account_status == 'admin';
    }
    match /marketing_templates/{templateId} {
      allow read, write: if request.auth != null &&
                            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.account_status == 'admin';
    }

    // Source material is transient and processed by Cloud Functions with the
    // Admin SDK. It must never be exposed through the broad default rule below.
    match /article_processing_jobs/{jobId} {
      allow read, write: if false;
    }

    // Discussion-topic totals are server-owned. Individual voter records are
    // private so a caller can read only their own current vote.
    match /article_discussion_stats/{statId} {
      allow read: if true;
      allow write: if false;
    }
    match /article_discussion_votes/{voteId} {
      allow get: if request.auth != null &&
                   (resource == null || resource.data.userId == request.auth.uid);
      allow list, create, update, delete: if false;
    }

    // Referral tracking for attributed signups. Public read; writes happen
    // server-side via the Admin SDK (the /r/<code> redirect + the agent).
    match /referrals/{code} {
      allow read: if true;
      allow write: if request.auth != null &&
                      get(/databases/$(database)/documents/users/$(request.auth.uid)).data.account_status == 'admin';
    }

    // Default rule for other collections (you should customize this). Keep
    // article_processing_jobs excluded: its documents hold temporary source text.
    match /{collection}/{document=**} {
      allow read, write: if collection != 'article_processing_jobs' &&
                           collection != 'growth_posts' &&
                           collection != 'growth_iterations' &&
                           collection != 'growth_config' &&
                           collection != 'marketing_cron_runs' &&
                           collection != 'marketing_templates' &&
                           collection != 'article_discussion_stats' &&
                           collection != 'article_discussion_votes';
    }
  }
}
