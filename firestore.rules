rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Blog posts rules
    match /blog_posts/{postId} {
      // Anyone can read published blog posts
      allow read: if resource.data.status == 'published' || 
                     (request.auth != null && 
                      get(/databases/$(database)/documents/users/$(request.auth.uid)).data.account_status == 'admin');
      
      // Only admins can write blog posts
      allow write: if request.auth != null && 
                      get(/databases/$(database)/documents/users/$(request.auth.uid)).data.account_status == 'admin';
    }
    
    // Member celebrations (leaderboard celebration wall)
    match /celebrations/{celebrationId} {
      // Anyone can read celebrations
      allow read: if true;

      // Only admins can create/update/delete celebrations
      allow write: if request.auth != null &&
                      get(/databases/$(database)/documents/users/$(request.auth.uid)).data.account_status == 'admin';
    }

    // Growth / marketing agent — admin-only from the client.
    // The agent itself runs on Cloud Run via the Admin SDK, which bypasses rules.
    match /growth_posts/{postId} {
      allow read, write: if request.auth != null &&
                            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.account_status == 'admin';
    }
    match /growth_iterations/{iterationId} {
      allow read, write: if request.auth != null &&
                            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.account_status == 'admin';
    }
    match /growth_config/{docId} {
      allow read, write: if request.auth != null &&
                            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.account_status == 'admin';
    }

    // Referral tracking for attributed signups. Public read; writes happen
    // server-side via the Admin SDK (the /r/<code> redirect + the agent).
    match /referrals/{code} {
      allow read: if true;
      allow write: if request.auth != null &&
                      get(/databases/$(database)/documents/users/$(request.auth.uid)).data.account_status == 'admin';
    }

    // Default rule for other collections (you should customize this)
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
